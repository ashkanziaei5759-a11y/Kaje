# ─────────────────────────────────────────────────────────────────────────────
# Kajeh / کاژه — environment configuration
# Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Required.
DATABASE_URL="postgresql://kajeh:kajeh@localhost:5432/kajeh?schema=public"

# Secret used to sign session cookies (HS256). Required, minimum 32 characters.
# There is deliberately no development fallback — a default secret that reaches
# production is an authentication bypass.
#   Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Public base URL. The QR code encodes this, so it must be the address diners
# actually reach — not localhost — before you print any codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Slug of the restaurant whose menu is served at /menu.
# Only needed when running more than one restaurant from one deployment.
RESTAURANT_SLUG="kajeh"
